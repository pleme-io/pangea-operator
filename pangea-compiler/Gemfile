# frozen_string_literal: true
#
# Standard nixpkgs bundlerApp Gemfile pattern: declare the app as a
# gem (via `gemspec`), pin provider versions to local paths so the
# Nix build can vendor them. Vendored repos are populated by the
# regen helper (locally) or the synth derivation (in the Nix build);
# either way, both produce vendor/<name>/ for bundler to resolve.

source 'https://rubygems.org'

gemspec

gem 'pangea-core',          path: 'vendor/pangea-core'
gem 'pangea-akeyless',      path: 'vendor/pangea-akeyless'
gem 'pangea-aws',           path: 'vendor/pangea-aws'
gem 'pangea-azure',         path: 'vendor/pangea-azure'
gem 'pangea-cloudflare',    path: 'vendor/pangea-cloudflare'
gem 'pangea-datadog',       path: 'vendor/pangea-datadog'
gem 'pangea-gcp',           path: 'vendor/pangea-gcp'
gem 'pangea-github',        path: 'vendor/pangea-github'
gem 'pangea-hcloud',        path: 'vendor/pangea-hcloud'
gem 'pangea-kubernetes',    path: 'vendor/pangea-kubernetes'
gem 'pangea-porkbun',       path: 'vendor/pangea-porkbun'
gem 'pangea-splunk',        path: 'vendor/pangea-splunk'
gem 'pangea-spot',          path: 'vendor/pangea-spot'

# pangea-architectures bundling intentionally deferred — adding it
# requires regenerating Gemfile.lock + gemset.nix together (bundix
# pipeline). M1 of theory/PANGEA-WORKSPACE-RECONCILIATION.md still
# demonstrates the load-and-verify contract correctly: the operator's
# ArchitectureGem reconciler RPCs the compiler, observes that
# Pangea::Architectures.constants is empty (gem not loaded), and
# emits a typed `ExpectedClassesMissing` condition naming every
# missing class. That's the substrate-level signal we wanted:
# instead of silent retry-loop, the LoadError class is structurally
# reported. Bundling will land in a follow-up that regens the bundle
# tree end-to-end.

# frozen_string_literal: true
#
# Pangea Compiler service Gemfile.
#
# Provider gems are vendored under vendor/<gem-name>:
#   - Locally:  the regen helper symlinks sibling pleme-io repos into
#               vendor/, then runs `bundle lock --update` + `bundix`.
#   - In Nix:   the compiler image's synth derivation copies each
#               provider gem from a flake input into vendor/<gem-name>.
#
# Both flows resolve to the same vendor/* paths, so Gemfile.lock and
# gemset.nix are deterministic across dev and build.

source 'https://rubygems.org'

# HTTP layer
gem 'sinatra', '~> 4.0'
gem 'puma',    '~> 6.0'
gem 'json'

# Synthesis framework (RubyGems)
gem 'terraform-synthesizer', '~> 0.0.28'

# Pangea provider gems (vendored — see header)
gem 'pangea-core',          path: 'vendor/pangea-core'
gem 'pangea-akeyless',      path: 'vendor/pangea-akeyless'
gem 'pangea-aws',           path: 'vendor/pangea-aws'
gem 'pangea-azure',         path: 'vendor/pangea-azure'
gem 'pangea-cloudflare',    path: 'vendor/pangea-cloudflare'
gem 'pangea-datadog',       path: 'vendor/pangea-datadog'
gem 'pangea-gcp',           path: 'vendor/pangea-gcp'
gem 'pangea-hcloud',        path: 'vendor/pangea-hcloud'
gem 'pangea-kubernetes',    path: 'vendor/pangea-kubernetes'
gem 'pangea-splunk',        path: 'vendor/pangea-splunk'
gem 'pangea-spot',          path: 'vendor/pangea-spot'
gem 'pangea-architectures', path: 'vendor/pangea-architectures'

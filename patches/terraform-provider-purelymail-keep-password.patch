@@ -0,0 +1,23 @@
+package purelymail
+
+import (
+	"testing"
+
+	"github.com/hashicorp/terraform-plugin-framework/types"
+)
+
+func TestModifyUserBodySendsThePasswordOnlyWhenItChanged(t *testing.T) {
+	old := userModel{Username: types.StringValue("a@example.com"), Password: types.StringValue("first")}
+	same := userModel{Username: types.StringValue("a@example.com"), Password: types.StringValue("first"), RequireTwoFactorAuthentication: types.BoolValue(true)}
+	body := modifyUserBody(same, old)
+	if _, sent := body["newPassword"]; sent {
+		t.Fatalf("an unchanged password was sent, which resets what the person chose: %v", body)
+	}
+	if body["requireTwoFactorAuthentication"] != true {
+		t.Fatalf("the requested change was dropped: %v", body)
+	}
+	changed := userModel{Username: types.StringValue("a@example.com"), Password: types.StringValue("second")}
+	if got := modifyUserBody(changed, old)["newPassword"]; got != "second" {
+		t.Fatalf("a changed password was not sent: %v", got)
+	}
+}
